# Required: development, testing, staging or production. There is no
# default; a missing or misspelt value stops the backend from starting.
APP_ENV=development
APP_NAME=OrderBridge
APP_VERSION=0.1.0

DATABASE_URL=postgresql+psycopg://<username>:<password>@<host>:5432/<database>

# Dedicated database for automated tests. It must be a different database from
# DATABASE_URL and its name must end in "_test". Tests never fall back to
# DATABASE_URL and refuse to run if this check fails.
TEST_DATABASE_URL=postgresql+psycopg://<username>:<password>@<host>:5432/orderbridge_test

# --- Authentication: phone OTP and server-side sessions ---------------------
# HMAC key for OTP digests. Required in production: at least 32 random
# characters, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit a real value. Leave empty in development and testing to use a
# random key per process (pending OTPs then stop working after a restart).
# Production also rejects obvious placeholders (e.g. "changeme", "<...>",
# repeated characters). Generating and storing the real secret in the host's
# secret manager is a deployment responsibility.
AUTH_SECRET_KEY=

AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
# Cumulative brute-force lockout per phone number, across all challenges:
# this many failed verifications within the rolling window lock the number.
AUTH_OTP_LOCKOUT_THRESHOLD=10
AUTH_OTP_LOCKOUT_WINDOW_SECONDS=86400
AUTH_SESSION_TTL_SECONDS=604800
AUTH_SESSION_COOKIE_NAME=orderbridge_session

# Must be true in production (HTTPS only). Set false only for local HTTP
# development; the default is true.
AUTH_SESSION_COOKIE_SECURE=false

# Keep lax. The planned production setup is same-origin: the browser calls the
# Next.js app, whose API proxy forwards to FastAPI, so the session cookie is a
# first-party, host-only cookie (HttpOnly, Secure, SameSite=lax, Path=/).
# The proxy must pass the browser's Origin/Referer, Cookie and Set-Cookie
# headers through unchanged. Do not use "none" to make cross-site calls work.
AUTH_SESSION_COOKIE_SAMESITE=lax

# Local development OTP delivery: the backend prints each issued code to its
# own terminal (stderr). Codes are never returned in API responses. Only
# allowed with APP_ENV=development; refused in testing, staging, production.
AUTH_DEBUG_OTP=true

# Optional local development "mock SMS outbox" for end-to-end tests: each
# issued code is also appended as a JSON line ({"phone_number", "code",
# "issued_at"}) to this file, created with owner-only permissions (0600).
# Relative paths are resolved against the repository root. Only allowed with
# APP_ENV=development and AUTH_DEBUG_OTP=true; the backend refuses to start
# with it in testing, staging or production. Leave empty to disable. The
# default name below is gitignored.
AUTH_DEV_OTP_OUTBOX_PATH=.dev-otp-outbox.jsonl

# Reviewer access for a deployment without an SMS provider. Empty by default
# (off). AUTH_DEMO_OTP_NUMBERS may list only the four synthetic demo
# accounts below; any other number stops the backend from starting.
# Whenever it lists any, AUTH_DEMO_ACCESS_KEY is required (every environment):
# a private random value of at least 32 characters, different from
# AUTH_SECRET_KEY, for example the output of
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Only a browser that has entered this key under "Reviewer access" on the
# sign-in page sees the demo accounts' codes; any other browser can neither
# receive, issue nor verify codes for those numbers. Store the key only in
# the host's secret settings and give it to the reviewer privately. Never
# commit it. Example for a review deployment:
#   AUTH_DEMO_OTP_NUMBERS=["9000000001","9000000002","9000000003","9000000010"]
AUTH_DEMO_OTP_NUMBERS=[]
AUTH_DEMO_ACCESS_KEY=

# JSON list of trusted frontend origins (scheme://host[:port], no path).
# Used for credentialed CORS and the CSRF origin check on state-changing
# requests. Values are canonicalised (lower case, default ports dropped) and
# de-duplicated. Must be https in production: set it to the public frontend
# origin. Add the API's own origin (for example http://localhost:8000) to use
# POST endpoints from /docs.
FRONTEND_ORIGINS=["http://localhost:3000"]

# Rate limits on the unauthenticated OTP endpoints (fixed windows, shared
# through PostgreSQL, HTTP 429 + Retry-After when exceeded). Per client IP
# and per normalised phone number. Windows are at most 86400 seconds.
RATE_LIMIT_OTP_REQUEST_IP_LIMIT=30
RATE_LIMIT_OTP_REQUEST_IP_WINDOW_SECONDS=900
RATE_LIMIT_OTP_REQUEST_PHONE_LIMIT=5
RATE_LIMIT_OTP_REQUEST_PHONE_WINDOW_SECONDS=3600
RATE_LIMIT_OTP_VERIFY_IP_LIMIT=60
RATE_LIMIT_OTP_VERIFY_IP_WINDOW_SECONDS=900
RATE_LIMIT_OTP_VERIFY_PHONE_LIMIT=15
RATE_LIMIT_OTP_VERIFY_PHONE_WINDOW_SECONDS=3600
# Chance (0-1) that a rate-limited request also deletes up to 1,000 expired
# counters. 0 disables it (then purge them another way).
RATE_LIMIT_CLEANUP_PROBABILITY=0.01

# JSON list of networks whose X-Forwarded-For header is believed when
# working out the client IP for rate limits. Empty: ignore forwarded headers
# and use the TCP peer (correct for local development). Behind a hosting
# load balancer, list the load balancer's own network after confirming it on
# the deployment. Catch-all networks (0.0.0.0/0, ::/0) are refused.
# Run uvicorn with --no-proxy-headers so only the application reads them.
TRUSTED_PROXY_CIDRS=[]

# Largest accepted request body in bytes (1024 to 10485760). Larger bodies
# get HTTP 413 before they are read into memory.
MAX_REQUEST_BODY_BYTES=65536

# Message capture reader. "rules" (default): deterministic word rules, no
# AI. "gemini": Google Gemini reads the message, then OrderBridge checks
# every phrase against the message and matches products with its own rules;
# any Gemini failure falls back to the rules. Only the message text and the
# products' codes and names are sent to Gemini.
CAPTURE_INTERPRETER=rules
# Secret (Google AI Studio API key). Required when CAPTURE_INTERPRETER=gemini.
# Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=8

# TallyPrime XML voucher download (Order desk > Tally export > batch).
# Exact names of ledgers that already exist in your Tally company; there are
# no defaults. The discount ledger is needed only for batches with a
# discount. Unset: the XML download says what is missing; the CSV still works.
TALLY_SALES_LEDGER_NAME=
TALLY_DISCOUNT_LEDGER_NAME=
TALLY_VOUCHER_TYPE_NAME=Sales
