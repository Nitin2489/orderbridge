APP_ENV=development
APP_NAME=OrderBridge
APP_VERSION=0.1.0

DATABASE_URL=postgresql+psycopg://<username>:<password>@<host>:5432/<database>

# Dedicated database for automated tests. It must be a different database from
# DATABASE_URL and its name must end in "_test". Tests never fall back to
# DATABASE_URL and refuse to run if this check fails.
TEST_DATABASE_URL=postgresql+psycopg://<username>:<password>@<host>:5432/orderbridge_test

# --- Authentication: phone OTP and server-side sessions ---------------------
# HMAC key for OTP digests. Required in production: at least 32 random
# characters, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit a real value. Leave empty in development and testing to use a
# random key per process (pending OTPs then stop working after a restart).
# Production also rejects obvious placeholders (e.g. "changeme", "<...>",
# repeated characters). Generating and storing the real secret in the host's
# secret manager is a deployment responsibility.
AUTH_SECRET_KEY=

AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_SESSION_TTL_SECONDS=604800
AUTH_SESSION_COOKIE_NAME=orderbridge_session

# Must be true in production (HTTPS only). Set false only for local HTTP
# development; the default is true.
AUTH_SESSION_COOKIE_SECURE=false

# Keep lax. The planned production setup is same-origin: the browser calls the
# Next.js app, whose API proxy forwards to FastAPI, so the session cookie is a
# first-party, host-only cookie (HttpOnly, Secure, SameSite=lax, Path=/).
# The proxy must pass the browser's Origin/Referer, Cookie and Set-Cookie
# headers through unchanged. Do not use "none" to make cross-site calls work.
AUTH_SESSION_COOKIE_SAMESITE=lax

# Development mock OTP delivery: returns the code as debug_otp in the
# request-otp response. Refused when APP_ENV=production.
AUTH_DEBUG_OTP=true

# JSON list of trusted frontend origins (scheme://host[:port], no path).
# Used for credentialed CORS and the CSRF origin check on state-changing
# requests. Values are canonicalised (lower case, default ports dropped) and
# de-duplicated. Must be https in production: set it to the public frontend
# origin. Add the API's own origin (for example http://localhost:8000) to use
# POST endpoints from /docs.
FRONTEND_ORIGINS=["http://localhost:3000"]
