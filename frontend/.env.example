# OrderBridge frontend environment. Copy to .env.local for development.
# Never commit real values. Only placeholders belong in this file.

# Origin of the FastAPI backend that the same-origin /api proxy forwards to.
# Server-side only (deliberately not NEXT_PUBLIC_), and read at build time.
# Development default if unset: http://127.0.0.1:8000
# Production: required, e.g. https://<your-backend-host>
BACKEND_ORIGIN=http://127.0.0.1:8000
